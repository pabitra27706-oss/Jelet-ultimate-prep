{
  "name": "jelet-ultimate-prep",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "build": "astro build && npm run packs && astro build",
    "packs": "node scripts/build-packs.mjs",
    "check": "astro check",
    "content": "node scripts/build-content.mjs",
    "topics": "node scripts/build-topics.mjs",
    "topics:check": "node scripts/build-topics.mjs --check",
    "variants": "node scripts/build-variants.mjs",
    "variants:check": "node scripts/build-variants.mjs --check",
    "coverage:delta": "node scripts/measure-coverage.mjs",
    "coverage:baseline": "node scripts/find-baseline-split.mjs",
    "preview": "node scripts/preview.mjs",
    "test": "npm run test:key-safety && npm run test:rules && npm run test:figures && npm run test:phase05 && npm run test:phase06 && npm run test:phase07 && npm run test:phase08 && npm run test:mock && npm run test:remediation && npm run test:quiz && npm run test:browser",
    "test:key-safety": "node --test tests/derived-key-safety.test.mjs tests/provisional-aids.test.mjs tests/provisional-practice.test.mjs",
    "validate:keys": "node scripts/validate-keys.mjs",
    "test:rules": "node --test tests/rules.test.mjs tests/original-papers.test.mjs",
    "test:phase05": "node --test tests/phase05.test.mjs",
    "test:phase06": "node --test tests/phase06.test.mjs",
    "test:phase07": "node --test tests/phase07.test.mjs",
    "test:phase08": "node --test tests/phase08.test.mjs",
    "test:mock": "node --test tests/mock.test.mjs",
    "test:remediation": "node --test tests/remediation.test.mjs",
    "test:quiz": "node --test tests/quiz.test.mjs",
    "test:browser": "node --test --test-timeout=120000 tests/site.test.mjs",
    "rollback:rehearse": "node scripts/rollback-rehearsal.mjs",
    "test:figures": "node --test tests/figures.test.mjs tests/figure-expansion.test.mjs",
    "figures": "node scripts/build-figures.mjs",
    "figures:check": "node scripts/build-figures.mjs --check"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@sparticuz/chromium": "153.0.0",
    "astro": "7.4.13",
    "katex": "^0.16.22",
    "playwright-core": "1.65.1",
    "typescript": "5.9.3"
  }
}
