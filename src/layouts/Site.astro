---
import '../styles/site.css';
const {
  title,
  active = '',
  canonical,
  description = 'Free, independent JELET Paper I preparation: previous-year papers with board answer keys, timed practice, marking rules and spaced revision.',
} = Astro.props as {
  title: string;
  active?: 'today' | 'learn' | 'practice' | 'library' | 'review' | 'search' | 'workspace' | 'syllabus' | 'offline' | 'coverage' | '';
  canonical?: string;
  description?: string;
};
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const nav = [
  { key: 'today', label: 'Today', href: base },
  { key: 'learn', label: 'Learn', href: `${base}learn/` },
  { key: 'practice', label: 'Practice', href: `${base}practice/` },
  { key: 'library', label: 'Papers', href: `${base}library/` },
  { key: 'review', label: 'Review', href: `${base}review/` },
];
const tabs = [
  { key: 'today', label: 'Today', icon: '◎', href: base },
  { key: 'learn', label: 'Learn', icon: '◍', href: `${base}learn/` },
  { key: 'practice', label: 'Practice', icon: '✎', href: `${base}practice/` },
  { key: 'library', label: 'Papers', icon: '☰', href: `${base}library/` },
  { key: 'review', label: 'Review', icon: '↻', href: `${base}review/` },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a5c4c" />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <link rel="icon" href={`${base}icon.svg`} type="image/svg+xml" />
    <link rel="stylesheet" href={`${base}vendor/katex/katex.min.css`} />
    {canonical && <link rel="canonical" href={canonical} />}
    <title>{title} · JELET Ultimate Prep</title>
    <script is:inline>
      // Set the theme before first paint so a dark-mode learner never sees a flash.
      (() => {
        try {
          const stored = localStorage.getItem('jelet:theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (stored === 'dark' || stored === 'light') document.documentElement.dataset.theme = stored;
          else if (prefersDark) document.documentElement.dataset.theme = 'dark';
        } catch { /* storage blocked: keep the default light theme */ }
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="appbar">
      <div class="wrap appbar-inner">
        <a href={base} class="brand"><span aria-hidden="true" class="mark">J</span><span>JELET <small>Ultimate Prep</small></span></a>
        <nav class="appnav" aria-label="Main">
          {nav.map((item) => <a href={item.href} aria-current={active === item.key ? 'page' : undefined}>{item.label}</a>)}
          <a href={`${base}search/`} aria-current={active === 'search' ? 'page' : undefined}>Search</a>
        </nav>
        <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch between light and dark"><span data-theme-icon aria-hidden="true">☾</span></button>
      </div>
    </header>
    <main class:list={['wrap', 'main']} id="main" tabindex="-1">
      {['library', 'practice', 'review'].includes(active) && (
        <aside class="notice" aria-label="Question and answer accuracy notice" data-content-caution style="margin-bottom:1.2rem">
          <strong>Some questions and answers have unresolved issues.</strong>
          <p style="margin:.4rem 0 0">Known issues include transcription errors, ambiguous wording and disputed answers. Derived answers are not official board keys, and agreement between AI reviews does not guarantee correctness. Official key labels are retained, but a matching label does not verify the transcribed option text.</p>
          <p style="margin:.4rem 0 0">Use scores as practice feedback, not a certified measure of exam readiness. If an item appears inconsistent, consult the original paper and the applicable final board key, where available. Further answer review is paused; this notice does not resolve the issues or change which questions are marked.</p>
        </aside>
      )}
      <slot />
    </main>
    <footer>
      <div class="wrap footer-inner">
        <div>
          <strong>JELET Ultimate Prep</strong> · Independent study site · Not affiliated with WBJEEB
          <div class="micro">
            <a href={`${base}workspace/`}>Workspace</a> · <a href={`${base}search/`}>Search</a> ·
            <a href={`${base}syllabus/`}>Syllabus</a> · <a href={`${base}library/`}>Paper library</a> ·
            <a href={`${base}coverage/`}>Coverage</a> · <a href={`${base}notes/mathematics/`}>Revision notes</a>
          </div>
        </div>
        <div class="micro">Your answers, bookmarks and notes stay in this browser. No account, no upload.</div>
      </div>
    </footer>
    <nav class="tabbar" aria-label="Main">
      {tabs.map((tab) => (
        <a href={tab.href} aria-current={active === tab.key ? 'page' : undefined}>
          <span aria-hidden="true">{tab.icon}</span><span>{tab.label}</span>
        </a>
      ))}
    </nav>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
      const themeIcon = toggle?.querySelector<HTMLElement>('[data-theme-icon]');
      const currentTheme = document.documentElement.dataset.theme
        ?? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      const showNextTheme = (theme: string) => { if (themeIcon) themeIcon.textContent = theme === 'dark' ? '☀' : '☾'; };
      showNextTheme(currentTheme);
      toggle?.addEventListener('click', () => {
        const current = document.documentElement.dataset.theme
          ?? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        showNextTheme(next);
        try { localStorage.setItem('jelet:theme', next); } catch { /* storage blocked: the choice lasts this page only */ }
      });

      // Offline support. The worker only caches this site's own files.
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          const base = document.querySelector<HTMLLinkElement>('link[rel="manifest"]')?.href ?? '/';
          const workerUrl = new URL('sw.js', base).href;
          navigator.serviceWorker.register(workerUrl, { scope: new URL('./', base).pathname }).catch(() => undefined);
        });
      }
    </script>
  </body>
</html>
