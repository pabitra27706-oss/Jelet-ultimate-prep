---
/**
 * The shared app shell.
 *
 * One header, one five-destination navigation and one footer are used by
 * every route. The five global destinations are Today, Learn, Practice,
 * Papers and You; Review, Plan, Search, Syllabus, Offline, Coverage,
 * Workspace and the revision notes stay reachable from the footer, from the
 * pages that own them and from the You hub. No route was removed.
 */
import '../styles/site.css';
import Icon from '../components/Icon.astro';
import type { IconName } from '../lib/icons';

const {
  title,
  active = '',
  canonical,
  description = 'Free, independent JELET Paper I preparation: previous-year papers with board answer keys, timed practice, marking rules and spaced revision.',
} = Astro.props as {
  title: string;
  active?:
    | 'today'
    | 'learn'
    | 'practice'
    | 'library'
    | 'you'
    | 'review'
    | 'search'
    | 'workspace'
    | 'syllabus'
    | 'offline'
    | 'coverage'
    | '';
  canonical?: string;
  description?: string;
};

const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';

/** The five global destinations, in the order the references show them. */
const primary: { key: string; label: string; icon: IconName; href: string }[] = [
  { key: 'today', label: 'Today', icon: 'home', href: base },
  { key: 'learn', label: 'Learn', icon: 'book', href: `${base}learn/` },
  { key: 'practice', label: 'Practice', icon: 'target', href: `${base}practice/` },
  { key: 'library', label: 'Papers', icon: 'papers', href: `${base}library/` },
  { key: 'you', label: 'You', icon: 'user', href: `${base}you/` },
];

/** Routes that kept their addresses but are no longer primary tabs. */
const secondary: { label: string; href: string }[] = [
  { label: 'Review', href: `${base}review/` },
  { label: 'Plan', href: `${base}plan/` },
  { label: 'Search', href: `${base}search/` },
  { label: 'Syllabus', href: `${base}syllabus/` },
  { label: 'Offline packs', href: `${base}offline/` },
  { label: 'Coverage', href: `${base}coverage/` },
  { label: 'Workspace', href: `${base}workspace/` },
  { label: 'Revision notes', href: `${base}notes/mathematics/` },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#087e78" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101a1a" media="(prefers-color-scheme: dark)" />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <link rel="icon" href={`${base}icon.svg`} type="image/svg+xml" />
    <link rel="stylesheet" href={`${base}vendor/katex/katex.min.css`} />
    {canonical && <link rel="canonical" href={canonical} />}
    <title>{title} · JELET Ultimate Prep</title>
    <script is:inline>
      // Set the theme and the motion preference before first paint so a
      // dark-mode learner never sees a flash and a reduced-motion learner
      // never sees a transition they asked not to have.
      (() => {
        const device = () => ({
          theme: (() => { try { return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'; } catch { return 'light'; } })(),
          motion: (() => { try { return window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'reduce' : 'full'; } catch { return 'full'; } })(),
        });
        try {
          const storedTheme = localStorage.getItem('jelet:theme');
          const storedMotion = localStorage.getItem('jelet:motion:v1');
          const fallback = device();
          document.documentElement.dataset.theme = storedTheme === 'dark' || storedTheme === 'light' ? storedTheme : fallback.theme;
          document.documentElement.dataset.motion = storedMotion === 'reduce' || storedMotion === 'full' ? storedMotion : fallback.motion;
        } catch { /* storage blocked: match the device instead */
          const fallback = device();
          document.documentElement.dataset.theme = fallback.theme;
          document.documentElement.dataset.motion = fallback.motion;
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="appbar">
      <div class="wrap appbar-inner">
        <a href={base} class="brand" aria-label="JELET Ultimate Prep — Today">
          <span aria-hidden="true" class="mark">J</span>
          <span class="brand-text">JELET <small>Ultimate Prep</small></span>
        </a>
        <nav class="appnav" aria-label="Main">
          {primary.map((item) => (
            <a
              href={item.href}
              class="appnav-link"
              aria-label={item.label}
              aria-current={active === item.key ? 'page' : undefined}
            >
              <Icon name={item.icon} size="sm" />
              <span class="appnav-label">{item.label}</span>
            </a>
          ))}
        </nav>
        <div class="appbar-tools">
          <a
            class="iconbtn"
            href={`${base}search/`}
            aria-label="Search questions and pages"
            aria-current={active === 'search' ? 'page' : undefined}
          >
            <Icon name="search" size="md" />
          </a>
          <button class="iconbtn theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark theme">
            <span class="theme-icon" data-theme-icon="moon"><Icon name="moon" size="md" /></span>
            <span class="theme-icon" data-theme-icon="sun"><Icon name="sun" size="md" /></span>
          </button>
        </div>
      </div>
    </header>
    <main class:list={['wrap', 'main']} id="main" tabindex="-1">
      {['library', 'practice', 'review'].includes(active) && (
        <details class="content-caution" aria-label="Question and answer accuracy notice" data-content-caution>
          <summary>
            <span class="caution-mark" aria-hidden="true">i</span>
            <span class="caution-summary"><strong>Accuracy note</strong><small>Some question text and answers have unresolved issues.</small></span>
            <span class="caution-action">Details <span aria-hidden="true">⌄</span></span>
          </summary>
          <div class="content-caution-copy">
            <p>Known issues include transcription errors, ambiguous wording and disputed answers. Derived answers are not official board keys, and agreement between AI reviews does not guarantee correctness. Official key labels are retained, but a matching label does not verify the transcribed option text.</p>
            <p>Use scores as practice feedback, not a certified measure of exam readiness. If an item appears inconsistent, consult the original paper and the applicable final board key, where available. Further answer review is paused; this notice does not resolve the issues or change which questions are marked.</p>
          </div>
        </details>
      )}
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-inner">
        <div class="footer-brand">
          <strong>JELET Ultimate Prep</strong>
          <span class="micro">Independent study site · Not affiliated with WBJEEB</span>
        </div>
        <nav class="footer-nav" aria-label="More destinations">
          {secondary.map((item) => <a href={item.href}>{item.label}</a>)}
          <a href={`${base}you/`} aria-current={active === 'you' ? 'page' : undefined}>You</a>
        </nav>
        <p class="micro footer-privacy">
          Your answers, bookmarks and notes stay in this browser. No account, no upload.
        </p>
      </div>
    </footer>
    <nav class="tabbar" aria-label="Main">
      {primary.map((tab) => (
        <a href={tab.href} aria-current={active === tab.key ? 'page' : undefined}>
          <span class="tab-icon"><Icon name={tab.icon} size="md" /></span>
          <span class="tab-label">{tab.label}</span>
        </a>
      ))}
    </nav>
    <script>
      import { initTheme } from '../lib/theme';
      import { initMotion } from '../lib/motion';

      initTheme();
      initMotion();

      // Offline support. The worker only caches this site's own files.
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          const base = document.querySelector<HTMLLinkElement>('link[rel="manifest"]')?.href ?? '/';
          const workerUrl = new URL('sw.js', base).href;
          navigator.serviceWorker.register(workerUrl, { scope: new URL('./', base).pathname }).catch(() => undefined);
        });
      }
    </script>
  </body>
</html>
