---
import { renderMath } from '../lib/math';
import type { Question as QuestionData } from '../lib/content';

const {
  question,
  mode = 'reader',
  keyLetters = [],
  keyTier = '',
  showKey = false,
  headingLevel = 'h3',
  anchor,
} = Astro.props as {
  question: QuestionData;
  mode?: 'reader' | 'runner';
  keyLetters?: string[];
  keyTier?: string;
  showKey?: boolean;
  headingLevel?: 'h2' | 'h3' | 'h4';
  anchor?: string;
};
const Heading = headingLevel;
const stemHtml = renderMath(question.stem);
const optionHtml = question.options.map((option) => ({ ...option, html: renderMath(option.text) }));
const held = !question.scorable;
---
<section
  class="qcard"
  id={anchor}
  data-question={question.id}
  data-n={question.n}
  data-category={question.category}
  data-marks={question.marks}
  data-subject={question.subject}
  data-subject-key={question.subjectKey}
  data-scorable={question.scorable ? 'yes' : 'no'}
>
  <div class="qhead">
    <Heading class="qnum">Q{question.n}</Heading>
    <span class="chip">{question.subject}</span>
    <span class="chip">Category {question.category === 'II' ? 'II' : 'I'}</span>
    <span class="chip">{question.marks} mark{question.marks === 1 ? '' : 's'}</span>
    {held && <span class="chip held">Not marked</span>}
    {question.voided && <span class="chip info">Voided by the board</span>}
  </div>
  <div class="qstem" set:html={stemHtml}></div>
  {question.transcriptionNote && <p class="micro"><strong>Transcription note:</strong> {question.transcriptionNote}</p>}
  {question.figureNote && <p class="holdnote">{question.figureNote}</p>}
  {question.options.length > 0 ? (
    <ul class="opts">
      {optionHtml.map((option) => {
        const isKey = keyLetters.includes(option.label);
        const state = showKey && isKey ? 'correct' : undefined;
        return (
          <li>
            {mode === 'runner' ? (
              <button
                type="button"
                class="opt"
                data-option={option.label}
                data-question={question.id}
                aria-pressed="false"
                aria-label={`Option ${option.label}`}
              >
                <span class="key" aria-hidden="true">{option.label}</span>
                <span class="txt" set:html={option.html}></span>
              </button>
            ) : (
              <div class="opt" data-state={state}>
                <span class="key" aria-hidden="true">{option.label}</span>
                <span class="txt" set:html={option.html}></span>
              </div>
            )}
          </li>
        );
      })}
    </ul>
  ) : (
    <p class="holdnote">The preserved transcription does not reproduce the options of this item.</p>
  )}
  {held && question.holdReason && !question.figureNote && (
    <p class="micro">{question.holdReason}</p>
  )}
  {showKey && keyLetters.length > 0 && (
    <div class="keynote">
      <strong>Answer: {keyLetters.join(', ')}</strong> · {keyTier}
      {mode === 'reader' && <span> — see the worked method and the paper it comes from in the practice view.</span>}
    </div>
  )}
  {showKey && question.voided && (
    <div class="keynote"><strong>Voided by the board.</strong> No option is keyed and the marks go to every candidate.</div>
  )}
</section>
