---
import { renderMath } from '../lib/math';
import Figure from './Figure.astro';
import type { Question as QuestionData } from '../lib/content';

const {
  question,
  mode = 'reader',
  keyLetters = [],
  keyTier = '',
  showKey = false,
  headingLevel = 'h3',
  anchor,
} = Astro.props as {
  question: QuestionData;
  mode?: 'reader' | 'runner';
  keyLetters?: string[];
  keyTier?: string;
  showKey?: boolean;
  headingLevel?: 'h2' | 'h3' | 'h4';
  anchor?: string;
};
const Heading = headingLevel;
const stemHtml = renderMath(question.stem);
const optionHtml = question.options.map((option) => ({ ...option, html: renderMath(option.text) }));
/**
 * An item is held when it cannot be marked at all. A question the board
 * voided is not held: the board awarded it to every candidate, so it carries
 * marks and it is marked — with the board's award rather than a key.
 */
const held = !question.scorable && !question.boardAwarded;
---
<section
  class="qcard"
  id={anchor}
  data-question={question.id}
  data-n={question.n}
  data-category={question.category}
  data-marks={question.marks}
  data-subject={question.subject}
  data-subject-key={question.subjectKey}
  data-scorable={question.scorable ? 'yes' : 'no'}
>
  <div class="qhead">
    <Heading class="qnum">Q{question.n}</Heading>
    <span class="chip">{question.subject}</span>
    <span class="chip">Category {question.category === 'II' ? 'II' : 'I'}</span>
    <span class="chip">{question.marks} mark{question.marks === 1 ? '' : 's'}</span>
    {held && <span class="chip held">Not marked</span>}
    {question.boardAwarded && <span class="chip info">Voided by the board · awarded to everyone</span>}
  </div>
  <div class="qstem" set:html={stemHtml}></div>
  {question.transcriptionNote && <p class="micro"><strong>Transcription note:</strong> {question.transcriptionNote}</p>}
  {
    question.figureAsset && (
      <Figure
        asset={question.figureAsset}
        caption={`Figure for Q${question.n}, redrawn from the values printed in the booklet.`}
      />
    )
  }
  {question.figureNote && <p class="holdnote">{question.figureNote}</p>}
  {question.options.length > 0 ? (
    <ul class="opts">
      {optionHtml.map((option) => {
        const isKey = keyLetters.includes(option.label);
        const state = showKey && isKey ? 'correct' : undefined;
        return (
          <li>
            {mode === 'runner' ? (
              <button
                type="button"
                class="opt"
                data-option={option.label}
                data-question={question.id}
                aria-pressed="false"
                aria-label={`Option ${option.label}`}
              >
                <span class="key" aria-hidden="true">{option.label}</span>
                <span class="txt" set:html={option.html}></span>
              </button>
            ) : (
              <div class="opt" data-state={state}>
                <span class="key" aria-hidden="true">{option.label}</span>
                <span class="txt" set:html={option.html}></span>
              </div>
            )}
          </li>
        );
      })}
    </ul>
  ) : (
    <p class="holdnote">The preserved transcription does not reproduce the options of this item.</p>
  )}
  {/*
    An item with a reconstructed figure carries two separate statements: the
    figure is a redraw, and the redraw does not make the item marked. Both are
    shown. Without a figure the note and the reason say the same thing, so
    only one of them is.
  */}
  {held && question.holdReason && (question.figureAsset || !question.figureNote) && (
    <p class="micro">{question.holdReason}</p>
  )}
  {mode === 'reader' && question.provisionalAid && (
    <details data-provisional-aid style="margin-top:1rem">
      <summary>{question.provisionalAid.state === 'provisional' ? 'Reveal provisional answer aid · not scored' : question.provisionalAid.state === 'unsolved' ? 'Answer not yet available · not scored' : 'Answer under dispute · not scored'}</summary>
      <div class="details-body">
        {question.provisionalAid.answer && <p><strong>Imported provisional label: {question.provisionalAid.answer}</strong></p>}
        <p>{question.provisionalAid.note}</p>
        <p class="micro">{question.provisionalAid.source}</p>
      </div>
    </details>
  )}
  {showKey && keyLetters.length > 0 && (
    <div class="keynote">
      <strong>Answer: {keyLetters.join(', ')}</strong> · {keyTier}
      {mode === 'reader' && <span> — see the worked method and the paper it comes from in the practice view.</span>}
    </div>
  )}
  {showKey && question.voided && (
    <div class="keynote"><strong>Voided by the board.</strong> No option is keyed and the marks go to every candidate.</div>
  )}
</section>
