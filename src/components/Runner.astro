---
import RunnerFrame from './RunnerFrame.astro';
import Pane from './Pane.astro';
import { type Paper, type Question as QuestionData } from '../lib/content';

const {
  paper,
  questions,
  mode = 'mock',
  subjectKey = null,
  subjectLabel = null,
  limitSeconds = null,
  scope,
} = Astro.props as {
  paper: Paper;
  questions: QuestionData[];
  mode?: 'mock' | 'drill';
  subjectKey?: string | null;
  subjectLabel?: string | null;
  limitSeconds?: number | null;
  scope: string;
};

const scopeMarks = questions.reduce((sum, question) => sum + question.marks, 0);
const title = mode === 'mock' ? `${paper.label} · full paper` : `${paper.label} · ${subjectLabel} drill`;
---

<RunnerFrame
  mode={mode}
  scope={scope}
  paperId={paper.id}
  paperYear={paper.year}
  paperLabel={paper.label}
  title={title}
  subjectKey={subjectKey}
  subjectLabel={subjectLabel}
  limitSeconds={limitSeconds}
  scopeMarks={scopeMarks}
  scopeQuestions={questions.length}
  attemptScope={scope}
>
  <Fragment slot="questions">
    {questions.map((question, index) => (
      <Pane
        question={question}
        number={question.n}
        position={index + 1}
        total={questions.length}
        sourcePaper={paper.id}
        sourceYear={paper.year}
        sourceN={question.n}
      />
    ))}
  </Fragment>
  <Fragment slot="navigator">
    {questions.map((question) => (
      <button type="button" data-nav={question.id} data-state="unanswered">{question.n}</button>
    ))}
  </Fragment>
  {questions.some((question) => question.boardAwarded) && (
    <Fragment slot="void-legend"><span><i class="v"></i> voided</span></Fragment>
  )}
</RunnerFrame>

<script>
  import { initRunner, readRunnerConfig } from '../lib/runner';

  const root = document.querySelector<HTMLElement>('[data-runner]');
  if (root) initRunner(readRunnerConfig(root));
</script>
