---
/**
 * You — the local study and settings hub.
 *
 * This is **not** an account: there is no sign-in, no profile, no avatar and
 * no server. It follows the reference settings screen: a calm privacy card,
 * one card of real preferences, two activity cards and one card of
 * destinations.
 *
 * Every number here is read from local storage at runtime. There is no
 * invented bookmark count and no fabricated "recently viewed" history. When
 * storage is blocked the page says so and stays usable.
 *
 * Phase 15 refines this destination against `01-settings.png`. Phase 14's
 * data contracts (theme key, workspace store, attempts, review queue, packs)
 * are unchanged.
 */
import Site from '../../layouts/Site.astro';
import Icon from '../../components/Icon.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { papers, scorablePapers } from '../../lib/content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const officialPapers = scorablePapers.filter((paper) => paper.keyTier === 'official');
const derivedPapers = scorablePapers.filter((paper) => paper.keyTier === 'derived');
const readOnlyPapers = papers.filter((paper) => !paper.hasKey);
const boardAwarded = papers.reduce((sum, paper) => sum + paper.boardAwardedQuestions, 0);
const totalQuestions = papers.reduce((sum, paper) => sum + paper.questionCount, 0);
---
<Site
  title="You"
  active="you"
  description="Your local JELET study hub: the theme and motion preferences, real on-device activity, offline packs and the study-record backup. No account and nothing uploaded."
>
  <div class="you">
    <h1 class="visually-hidden">You</h1>

    <section class="you-hero" aria-labelledby="privacy-heading">
      <span class="you-hero-icon" aria-hidden="true"><Icon name="lock" size={26} /></span>
      <div class="you-hero-copy">
        <h2 id="privacy-heading">Your study data stays on this device.</h2>
        <p>No account, no upload.</p>
      </div>
    </section>

    <noscript>
      <p class="micro">This page reads your local activity with JavaScript. The preferences and links still work without it.</p>
    </noscript>

    <h2 class="you-heading" id="preferences-heading">Preferences</h2>
    <section class="settings-card" aria-labelledby="preferences-heading">
      <div class="settings-row">
        <span class="settings-icon" aria-hidden="true"><Icon name="moon" size={22} /></span>
        <span class="settings-copy">
          <span class="settings-label" id="theme-label">Dark mode</span>
          <span class="settings-sub visually-hidden" id="theme-status" role="status" aria-live="polite" data-theme-status
            >Following this device’s setting until you choose.</span
          >
        </span>
        <button
          class="switch"
          type="button"
          role="switch"
          aria-checked="false"
          aria-labelledby="theme-label"
          aria-describedby="theme-status"
          data-theme-toggle
          data-theme-switch
        >
          <span class="switch-track" aria-hidden="true"><span class="switch-thumb"></span></span>
          <span class="switch-state visually-hidden" data-theme-state>Off</span>
        </button>
      </div>
      <div class="settings-row">
        <span class="settings-icon" aria-hidden="true"><Icon name="motion" size={22} /></span>
        <span class="settings-copy">
          <span class="settings-label" id="motion-label">Reduce motion</span>
          <span class="settings-sub visually-hidden" id="motion-status" role="status" aria-live="polite" data-motion-status
            >Following this device’s motion setting until you change it.</span
          >
        </span>
        <button
          class="switch"
          type="button"
          role="switch"
          aria-checked="false"
          aria-labelledby="motion-label"
          aria-describedby="motion-status"
          data-motion-toggle
        >
          <span class="switch-track" aria-hidden="true"><span class="switch-thumb"></span></span>
          <span class="switch-state visually-hidden" data-motion-state>Off</span>
        </button>
      </div>
    </section>

    <h2 class="you-heading" id="activity-heading">My activity</h2>
    <section aria-labelledby="activity-heading">
      <div class="you-activity">
        <a class="activity-card" href={`${base}workspace/`}>
          <span class="activity-icon" aria-hidden="true"><Icon name="bookmark" size={18} /></span>
          <span class="activity-label">Saved bookmarks</span>
          <span class="activity-value" data-you-saved>0</span>
          <span class="activity-go" aria-hidden="true"><Icon name="chevron-right" size="sm" /></span>
        </a>
        <a class="activity-card" href={`${base}practice/`}>
          <span class="activity-icon blue" aria-hidden="true"><Icon name="target" size={18} /></span>
          <span class="activity-label">Practice attempts</span>
          <span class="activity-value" data-you-attempts>0</span>
          <span class="activity-go" aria-hidden="true"><Icon name="chevron-right" size="sm" /></span>
        </a>
      </div>
      <p class="you-foot">
        <span data-you-saved-note>Nothing saved yet</span>
        <span aria-hidden="true">·</span>
        <a href={`${base}review/`}><span data-you-review>0</span> to review</a>
        <span class="visually-hidden" data-you-attempts-note>No attempt started yet</span>
      </p>
      <p class="visually-hidden" role="status" aria-live="polite" data-you-status>Reading this browser…</p>
    </section>

    <section class="settings-card" aria-label="Manage your record" style="margin-top:0">
      <a class="settings-row" href={`${base}offline/`} aria-describedby="packs-status">
        <span class="settings-icon" aria-hidden="true"><Icon name="download" size={22} /></span>
        <span class="settings-copy">
          <span class="settings-label">Manage offline packs</span>
          <span class="visually-hidden" id="packs-status" data-you-packs>Nothing downloaded yet</span>
        </span>
        <span class="settings-chevron" aria-hidden="true"><Icon name="chevron-right" size="sm" /></span>
      </a>
      <a class="settings-row" href={`${base}workspace/#record-backup`}>
        <span class="settings-icon" aria-hidden="true"><Icon name="upload" size={22} /></span>
        <span class="settings-copy">
          <span class="settings-label">Export backup</span>
        </span>
        <span class="settings-chevron" aria-hidden="true"><Icon name="chevron-right" size="sm" /></span>
      </a>
      <details class="settings-disclosure" data-about>
        <summary class="settings-row">
          <span class="settings-icon" aria-hidden="true"><Icon name="info" size={22} /></span>
          <span class="settings-copy">
            <span class="settings-label">About &amp; sources</span>
          </span>
          <span class="settings-chevron" aria-hidden="true"><Icon name="chevron-down" size="sm" /></span>
        </summary>
        <div class="settings-body">
          <div class="chip-row">
            <StatusBadge tone="official" icon="check-circle" label={`${officialPapers.length} papers with official keys`} />
            <StatusBadge tone="derived" icon="alert-triangle" label={`${derivedPapers.length} with derived keys`} />
            <StatusBadge tone="neutral" icon="papers" label={`${readOnlyPapers.length} read-only`} />
          </div>
          <p class="source-note">
            {totalQuestions} questions across {papers.length} previous-year papers. {boardAwarded} items were voided by
            the board and carry their marks to every candidate.
          </p>
          <p>
            No account, no sign-in and nothing uploaded. Export a backup before clearing browser data, because
            clearing it erases the record on this device.
          </p>
          <ul>
            <li>This site is not affiliated with or endorsed by the West Bengal Joint Entrance Examinations Board, and it does not host official question papers.</li>
            <li>Official key labels come from the board's own notices. Derived answers are provisional practice labels, not board keys, and agreement between AI reviews does not certify them.</li>
            <li>Nothing here predicts a rank or a score, and no answer is graded by AI. There is no analytics script, no account, no sync and no automatic download.</li>
            <li>The archived earlier site is kept locally for provenance and is never published.</li>
          </ul>
          <nav class="settings-links" aria-label="More destinations">
            <a href={`${base}review/`}>Review</a>
            <a href={`${base}plan/`}>Study plan</a>
            <a href={`${base}search/`}>Search</a>
            <a href={`${base}syllabus/`}>Syllabus</a>
            <a href={`${base}coverage/`}>Coverage</a>
            <a href={`${base}workspace/`}>Workspace</a>
            <a href={`${base}notes/mathematics/`}>Revision notes</a>
          </nav>
        </div>
      </details>
    </section>
  </div>

  <script>
    import { readAttempts } from '../../lib/attempts';
    import { readQueue } from '../../lib/review';
    import { readInstalled } from '../../lib/offline';
    import { storageAvailable } from '../../lib/theme';
    import { readWorkspaceSafe } from '../../workspace';

    const text = (selector: string, value: string) => {
      const node = document.querySelector<HTMLElement>(selector);
      if (node) node.textContent = value;
    };

    /** Whether this browser is actually keeping local state. */
    const storageWorks = storageAvailable();

    const attempts = readAttempts();
    const submitted = attempts.filter((attempt) => Boolean(attempt.submittedAt)).length;
    const queue = readQueue();
    const packs = readInstalled();

    text('[data-you-attempts]', String(attempts.length));
    text(
      '[data-you-attempts-note]',
      attempts.length === 0
        ? 'No attempt started yet'
        : `${submitted} submitted · ${attempts.length - submitted} open`,
    );
    text('[data-you-review]', String(queue.length));
    text(
      '[data-you-packs]',
      packs.length === 0
        ? 'Nothing downloaded yet'
        : `${packs.length} ${packs.length === 1 ? 'pack is' : 'packs are'} ready on this device`,
    );

    const workspace = await readWorkspaceSafe();
    let saved = 0;
    if (workspace.available && workspace.data) {
      const bookmarks = workspace.data.items.bookmarks.length;
      const notes = workspace.data.items.notes.length;
      saved = bookmarks + notes;
      text('[data-you-saved]', String(bookmarks));
      text(
        '[data-you-saved-note]',
        saved === 0
          ? 'Nothing saved yet'
          : `${bookmarks} ${bookmarks === 1 ? 'bookmark' : 'bookmarks'} · ${notes} ${notes === 1 ? 'note' : 'notes'}`,
      );
    } else {
      text('[data-you-saved]', '—');
      text('[data-you-saved-note]', 'Bookmarks are unavailable');
    }

    if (!storageWorks) {
      // A blocked store is a visible limitation, not a silent zero.
      document.querySelectorAll<HTMLElement>('[data-theme-status], [data-motion-status]').forEach((node) => {
        node.dataset.blocked = 'true';
      });
      text('[data-you-status]', 'This browser is blocking local storage. You can still study, but nothing will be saved on this device.');
      text('[data-you-attempts]', '—');
      text('[data-you-attempts-note]', 'Local storage is unavailable');
      text('[data-you-review]', '—');
      text('[data-you-packs]', 'Local storage is unavailable');
    } else if (!workspace.available) {
      text('[data-you-status]', `Read from this browser. ${attempts.length} ${attempts.length === 1 ? 'attempt' : 'attempts'} and ${queue.length} review ${queue.length === 1 ? 'item' : 'items'} on this device.`);
    } else if (attempts.length === 0 && queue.length === 0 && saved === 0) {
      text('[data-you-status]', 'Nothing is stored on this device yet. Reading a page does not count as activity.');
    } else {
      text('[data-you-status]', `Read from this browser. ${attempts.length} ${attempts.length === 1 ? 'attempt' : 'attempts'}, ${queue.length} review ${queue.length === 1 ? 'item' : 'items'} and ${saved} saved ${saved === 1 ? 'item' : 'items'} on this device.`);
    }
  </script>
</Site>
