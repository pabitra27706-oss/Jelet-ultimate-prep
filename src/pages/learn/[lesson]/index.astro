---
import { getCollection, render } from 'astro:content';
import Site from '../../../layouts/Site.astro';
import { validateSections } from '../../../progress.ts';
import { validateContent, type LessonData, type PracticeData } from '../../../content-check.ts';
import { parseTopicReference } from '../../../lib/topics.ts';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons', ({ data }) => data.status === 'open');
  const practice = await getCollection('practice');
  validateContent(
    lessons.map((entry) => ({ id: entry.id, data: entry.data as unknown as LessonData })),
    practice.map((entry) => ({ id: entry.id, data: entry.data as unknown as PracticeData })),
  );
  return lessons.map((lesson) => ({ params: { lesson: lesson.id } }));
}

const { lesson: lessonId } = Astro.params;
const lessons = await getCollection('lessons');
const lesson = lessons.find((entry) => entry.id === lessonId);
if (!lesson) throw new Error(`Unknown lesson: ${lessonId}`);
const data = lesson.data as unknown as LessonData;
const topic = parseTopicReference(data.topic);
if (!topic) throw new Error(`Lesson ${lesson.id} points at a topic the syllabus does not hold`);
validateSections(lesson.id, data.sections);

const { Content, headings } = await render(lesson);
const actual = headings.filter(({ depth }) => depth === 2).map(({ slug }) => slug);
if (actual.join('|') !== data.sections.join('|')) {
  throw new Error(`Lesson ${lesson.id} headings do not match its declared section IDs`);
}

const practice = (await getCollection('practice')).map((entry) => entry.data) as unknown as PracticeData[];
const backlinks = practice.filter((item) => item.primarySectionAnchor === 'independent-practice' && item.topic === data.topic);

const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const syllabusPage = `${base}notes/${data.subject}/`;
---

<Site title={data.title} active="learn" description={data.summary}>
  <nav class="crumb" aria-label="Breadcrumb">
    <a href={`${base}learn/`}>Learn</a> <span aria-hidden="true">/</span>
    <a href={syllabusPage}>{topic.subjectName}</a> <span aria-hidden="true">/</span>
    <span>{data.title}</span>
  </nav>
  <div class="page-intro lesson-intro">
    <p class="eyebrow">LESSON · {data.minutes} MIN · ORIGINAL · REVISION {data.revision}</p>
    <h1>{data.title}</h1>
    <p class="lead">{data.summary}</p>
    <p>{data.objective}</p>
    {data.prerequisites.length > 0 && (
      <p class="micro">Before this: {data.prerequisites.join(' · ')}</p>
    )}
    <p class="micro" data-origin hidden>From an original practice card · topic filter restored</p>
    <a class="button" href="#predict">Start with a prediction <span aria-hidden="true">↓</span></a>
  </div>
  <div class="lesson-grid">
    <aside class="toc">
      <nav aria-label="Lesson sections"><p class="eyebrow">IN THIS LESSON</p><ul>{headings.map(({ slug, text }) => <li><a href={`#${slug}`}>{text}</a></li>)}</ul></nav>
      <p class="micro" data-save-note aria-live="polite">No account or answers collected.</p>
      <p class="micro" data-hint-note hidden>Guided hint opened on this browser.</p>
      <p class="micro" data-attempt-note hidden>The independent check has been opened on this browser.</p>
    </aside>
    <article class="lesson-body" aria-label={`${data.title} lesson`}>
      <Content />
      {backlinks.length > 0 && <section class="related" aria-labelledby="related-practice">
        <p class="eyebrow">ORIGINAL PRACTICE CARD</p>
        <h2 id="related-practice">Take the independent check</h2>
        {backlinks.map((item) => (
          <a class="chapter-card" href={`${base}cards/${item.publicId}/?from=lesson&topic=${encodeURIComponent(item.topic)}`}>
            <span><strong>{item.title}</strong><small>{item.summary}</small></span><span aria-hidden="true">→</span>
          </a>
        ))}
      </section>}
      <section class="related" aria-labelledby="related-topic">
        <p class="eyebrow">REVISION</p>
        <h2 id="related-topic">{topic.subjectName} · {topic.name}</h2>
        <p class="micro">{topic.detail}</p>
        <p>
          <a class="chapter-card" href={`${base}notes/${data.subject}/#${topic.id}`}>
            <span><strong>The {topic.subjectName} notes</strong><small>Every past question in this topic, with your own results beside them</small></span><span aria-hidden="true">→</span>
          </a>
          <a class="chapter-card" href={`${base}mock/?s=${data.subject}&t=${encodeURIComponent(topic.code)}&n=10`}>
            <span><strong>A mock on this topic</strong><small>Ten questions drawn only from {topic.name}</small></span><span aria-hidden="true">→</span>
          </a>
        </p>
      </section>
      <p class="source">Syllabus context: the WBJEEB JELET 2026 information bulletin of 18 March 2026. Explanations and practice are original, not Board questions.</p>
      <a href={base}>← Back to Today</a>
    </article>
  </div>
  <span hidden data-lesson-id={lesson.id} data-lesson-sections={JSON.stringify(data.sections)} data-practice-topics={JSON.stringify(practice.map((item) => item.topic))}></span>
  <script>
    import { isSection, readProgress, saveProgress, validHints, type Progress, type Section } from '../../../progress.ts';

    const marker = document.querySelector<HTMLElement>('[data-lesson-id]');
    const lessonId = marker?.dataset.lessonId ?? '';
    const lessonSections = JSON.parse(marker?.dataset.lessonSections ?? '[]') as Section[];
    const practiceTopics = JSON.parse(marker?.dataset.practiceTopics ?? '[]') as string[];

    const { progress: previous, available } = readProgress(lessonId);
    const currentHash = () => location.hash.slice(1);
    const initial = currentHash();
    const first = lessonSections.includes('predict') ? 'predict' : lessonSections[0];
    let progress: Progress = { ...(previous ?? { guidedHints: [], independentRevealed: false }), section: isSection(initial) ? initial : first };
    const note = document.querySelector<HTMLElement>('[data-save-note]');
    const assisted = document.querySelector<HTMLElement>('[data-attempt-note]');
    const hints = document.querySelector<HTMLElement>('[data-hint-note]');
    function indicators() {
      if (assisted) assisted.hidden = !progress.independentRevealed;
      if (hints) hints.hidden = progress.guidedHints.length === 0;
    }
    function persisted() {
      if (note) {
        const message = saveProgress(lessonId, progress) ? 'Place saved on this browser.' : 'Could not save progress. Keep this tab open to preserve your place.';
        if (note.textContent !== message) note.textContent = message;
      }
      indicators();
    }
    if (!available && note) note.textContent = 'Progress cannot be saved on this browser.';
    indicators();
    function saveHash() {
      const hash = currentHash();
      if (isSection(hash)) {
        progress.section = hash;
        persisted();
      }
    }
    const url = new URL(location.href);
    if (url.searchParams.get('resume') === '1') {
      url.searchParams.delete('resume');
      history.replaceState(history.state, '', url.href);
      if (previous?.section === 'guided-practice' && initial === 'guided-practice') {
        const lastHint = previous.guidedHints.at(-1);
        if (lastHint && validHints.includes(lastHint)) {
          const hint = document.querySelector<HTMLDetailsElement>(`details[data-reveal="${lastHint}"]`);
          if (hint) hint.open = true;
        }
      }
    }
    saveHash();
    window.addEventListener('hashchange', saveHash);
    for (const details of document.querySelectorAll<HTMLDetailsElement>('details[data-reveal]')) {
      details.addEventListener('toggle', () => {
        if (!details.open) return;
        const key = details.dataset.reveal ?? '';
        if (validHints.includes(key)) {
          progress.guidedHints = [...new Set([...progress.guidedHints, key])];
          progress.section = 'guided-practice';
        } else if (key === 'independent-check') {
          progress.independentRevealed = true;
          progress.section = 'independent-practice';
        } else {
          progress.section = key === 'worked' ? 'worked-example' : 'guided-practice';
        }
        persisted();
      });
    }
    const headings = lessonSections.map((id) => document.getElementById(id));
    let interacted = false;
    const markInteraction = () => { interacted = true; };
    window.addEventListener('wheel', markInteraction, { passive: true });
    window.addEventListener('touchmove', markInteraction, { passive: true });
    window.addEventListener('keydown', (event) => {
      if (['ArrowDown', 'ArrowUp', 'PageDown', 'PageUp', 'Home', 'End', ' '].includes(event.key)) markInteraction();
    });
    function saveScroll() {
      if (!interacted) return;
      let last = progress.section;
      headings.forEach((heading, i) => { if (heading && heading.getBoundingClientRect().top <= 145) last = lessonSections[i]; });
      progress.section = last;
      persisted();
    }
    let timer: number | undefined;
    window.addEventListener('scroll', () => {
      if (!interacted) return;
      window.clearTimeout(timer);
      timer = window.setTimeout(saveScroll, 150);
    }, { passive: true });
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'hidden' && timer !== undefined) {
        window.clearTimeout(timer);
        saveScroll();
      }
    });

    const params = new URL(location.href).searchParams;
    const originNote = document.querySelector<HTMLElement>('[data-origin]');
    if (originNote && params.get('from') === 'practice' && practiceTopics.includes(params.get('topic') ?? '')) {
      originNote.hidden = false;
    }
  </script>
</Site>
