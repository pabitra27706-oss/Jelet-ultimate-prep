---
import Site from '../../layouts/Site.astro';
import { provisionalQuestions } from '../../lib/provisional-practice.mjs';
import { loadTeaching } from '../../teaching';
import { papers, rehearsableQuestions, subjectLabels, type SubjectKey } from '../../lib/content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const { practice } = await loadTeaching();
const items = practice.map((entry) => entry.data);
const keyed = papers.filter((paper) => paper.scoreableQuestions > 0);
const available = papers.filter(paper => paper.scoreableQuestions > 0 || provisionalQuestions(paper).length > 0);
const readOnly = papers.filter((paper) => paper.scoreableQuestions === 0 && provisionalQuestions(paper).length === 0);
---
<Site title="Practice" active="practice" description="Timed JELET Paper I practice: full-paper rehearsals, subject drills from real previous-year papers, original checks and a spaced review queue.">
  <div class="row-between" style="align-items:flex-start;margin-bottom:1.4rem">
    <div class="grow">
      <p class="eyebrow">Paper I · Practice</p>
      <h1>Choose a year to practise.</h1>
      <p class="lead">
        Official and existing derived-key rehearsals are separate from provisional historical practice.
        Provisional comparisons are labelled, exclude disputed or unavailable answers, and do not enter your normal results.
      </p>
    </div>
    <a class="btn ghost" href={`${base}review/`}>Review desk</a>
  </div>

  <section aria-labelledby="mocks">
    <div class="section-head">
      <h2 id="mocks">Papers · newest first</h2>
      <span class="micro">Choose a keyed rehearsal or clearly labelled provisional practice.</span>
    </div>
    <div class="card-grid">
      <div class="card-flat">
        <div class="row-between" style="align-items:flex-start">
          <div>
            <strong>Your own mock</strong>
            <div class="micro">
              Choose the subjects, the topics, the length, the category mix and the clock. The questions come from the
              same previous-year papers, and the marking is the board's own.
            </div>
          </div>
        </div>
        <div class="btn-row" style="margin-top:.6rem">
          <a class="btn small" href={`${base}mock/`}>Build a mock</a>
        </div>
      </div>
      {available.map((paper) => (
        <div class="card-flat">
          <div class="row-between" style="align-items:flex-start">
            <div>
              <strong>{paper.label}</strong>
              <div class="micro">
                {provisionalQuestions(paper).length ? `${provisionalQuestions(paper).length} provisional questions · untimed` : `${paper.scoreableQuestions} questions · ${paper.scoreableMarks} marks · ${paper.durationMinutes} minutes`}
              </div>
            </div>
            {paper.keyTier === 'official'
              ? <span class="chip official">Official</span>
              : <span class="chip derived">{provisionalQuestions(paper).length ? "Provisional · not verified" : "Derived"}</span>}
          </div>
          {paper.heldQuestions > 0 && provisionalQuestions(paper).length === 0 && (
            <p class="micro">Labelled incomplete: {paper.heldQuestions} questions are readable but not markable.</p>
          )}
          {paper.boardAwardedQuestions > 0 && (
            <p class="micro">{paper.boardAwardedQuestions} voided by the board — awarded to every candidate.</p>
          )}
          <div class="btn-row" style="margin-top:.6rem">
            <a class="btn small" href={`${base}practice/${paper.id}/`}>{provisionalQuestions(paper).length ? "Start provisional practice" : "Start the full paper"}</a>
            <a class="btn small ghost" href={`${base}library/${paper.id}/`}>Read it</a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section style="margin-top:2rem" aria-labelledby="drills">
    <div class="section-head">
      <h2 id="drills">Subject drills</h2>
      <span class="micro">The real size is shown. Nothing is padded with repeats.</span>
    </div>
    {keyed.map((paper) => {
      const drills = paper.subjects
        .map((subject) => {
          const list = rehearsableQuestions(paper, subject.subjectKey);
          return { ...subject, count: list.length, marks: list.reduce((sum, question) => sum + question.marks, 0) };
        })
        .filter((subject) => subject.count > 0);
      return (
        <div style="margin-bottom:1.4rem">
          <p class="eyebrow">{paper.label}</p>
          <ul class="linklist">
            {drills.map((subject) => (
              <li>
                <a href={`${base}practice/${paper.id}/${subject.subjectKey}/`}>
                  <span>
                    <strong>{subjectLabels[subject.subjectKey as SubjectKey]}</strong>
                    <small>{subject.count} questions · {subject.marks} marks · {Math.max(10, subject.marks)} minutes</small>
                  </span>
                  <span aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      );
    })}
  </section>

  <section style="margin-top:2rem" aria-labelledby="quiz-heading">
    <div class="section-head">
      <h2 id="quiz-heading">Notebook quiz</h2>
      <span class="micro">Untimed · one question at a time · marked as you go</span>
    </div>
    <p class="lead" style="margin:.4rem 0 .8rem">
      A quiz is not a paper. There is no clock and no navigator: you get one question, you check it, and the published
      answer and the paper it came from are shown straight away. Your place is kept on this device, so you can stop and
      come back.
    </p>
    <ul class="linklist">
      {(['mathematics', 'physics', 'chemistry', 'electrical'] as SubjectKey[]).map((subject) => (
        <li>
          <a href={`${base}quiz/?s=${subject}&n=10`}>
            <span>
              <strong>{subjectLabels[subject]} · ten questions</strong>
              <small>Marked as you answer them, with the paper each question came from</small>
            </span>
            <span aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section style="margin-top:2rem" aria-labelledby="notes-heading">
    <div class="section-head">
      <h2 id="notes-heading">Revision notes</h2>
      <span class="micro">Every topic, every past question, your own results beside them.</span>
    </div>
    <ul class="linklist">
      {(['mathematics', 'physics', 'chemistry', 'electrical'] as SubjectKey[]).map((subject) => (
        <li>
          <a href={`${base}notes/${subject}/`}>
            <span>
              <strong>{subjectLabels[subject]}</strong>
              <small>The topics of the syllabus and the past questions that sit in them</small>
            </span>
            <span aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section style="margin-top:2rem" aria-labelledby="queue-heading">
    <div class="section-head">
      <h2 id="queue-heading">Your review queue</h2>
    </div>
    <div class="card" id="queue-card">
      <p class="micro" data-queue-status>Checking this browser…</p>
    </div>
  </section>

  <section style="margin-top:2rem" aria-labelledby="original-heading">
    <div class="section-head">
      <h2 id="original-heading">Original practice cards</h2>
      <span class="micro">Written for this site. Not past exam questions.</span>
    </div>
    <ul class="linklist">
      {items.map((item) => (
        <li>
          <a href={`${base}cards/${item.publicId}/`}>
            <span>
              <strong>{item.title}</strong>
              <small>{item.summary}</small>
            </span>
            <span aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {readOnly.length > 0 && (
    <section class="card" style="margin-top:2rem">
      <h2 style="font-size:1.05rem">Papers you can read but not mark</h2>
      <p class="micro">
        No answer key has been published for these years, and this site does not invent one. They are still worth
        reading: the questions are the same kind you will face.
      </p>
      <ul class="linklist">
        {readOnly.map((paper) => (
          <li>
            <a href={`${base}library/${paper.id}/`}>
              <span><strong>{paper.label}</strong><small>{paper.questionCount} questions · read only</small></span>
              <span aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <script>
    import { readQueue, dueItems } from '../../lib/review';

    const base = document.querySelector<HTMLElement>('[data-base]')?.dataset.base ?? '/';
    const card = document.querySelector('#queue-card');
    const status = document.querySelector<HTMLElement>('[data-queue-status]');
    const queue = readQueue();
    const due = dueItems(queue);

    const drawQueue = () => {
      if (!card) return;
      if (queue.length === 0) {
        if (status) status.textContent = 'Your queue is empty. Questions you get wrong or leave blank land here automatically.';
        return;
      }
      card.replaceChildren();
      const head = document.createElement('p');
      head.className = 'micro';
      head.textContent = `${due.length} of ${queue.length} questions are due now. Each wrong answer sends a question back to the start of the ladder.`;
      const list = document.createElement('ul');
      list.className = 'linklist';
      for (const item of due.slice(0, 6)) {
        const li = document.createElement('li');
        const link = document.createElement('a');
        link.href = `${base}library/${item.paperId}/#q${item.n}`;
        const span = document.createElement('span');
        const strong = document.createElement('strong');
        strong.textContent = `${item.paperYear} · Q${item.n}`;
        const small = document.createElement('small');
        small.textContent = item.stem.slice(0, 110);
        span.append(strong, small);
        link.append(span);
        const arrow = document.createElement('span');
        arrow.setAttribute('aria-hidden', 'true');
        arrow.textContent = '→';
        link.append(arrow);
        li.append(link);
        list.append(li);
      }
      const more = document.createElement('p');
      more.className = 'micro';
      more.textContent = due.length > 6 ? `…and ${due.length - 6} more.` : '';
      card.append(head, list, more);
    };

    drawQueue();
  </script>
  <span hidden data-base={base}></span>
</Site>
