---
import Site from '../../../layouts/Site.astro';
import Runner from '../../../components/Runner.astro';
import ProvisionalPractice from '../../../components/ProvisionalPractice.astro';
import { provisionalQuestions } from '../../../lib/provisional-practice.mjs';
import { papers, paperById, keyFor, keyTierLabel, rehearsableQuestions } from '../../../lib/content';

export function getStaticPaths() {
  return papers
    .filter((paper) => paper.scoreableQuestions > 0 || provisionalQuestions(paper).length > 0)
    .map((paper) => ({ params: { paper: paper.id } }));
}

const { paper: paperId } = Astro.params;
const paper = paperById.get(paperId ?? '');
if (!paper) throw new Error(`Unknown paper: ${paperId}`);
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const key = keyFor(paper);
const tierLabel = keyTierLabel(key);
const provisional = provisionalQuestions(paper);
const questions = rehearsableQuestions(paper);
const limitSeconds = paper.durationMinutes * 60;
const scopeMarks = questions.reduce((sum, question) => sum + question.marks, 0);
---
<Site title={`${paper.label} · full paper`} active="practice" description={provisional.length ? `Provisional practice for ${paper.label}; not an official score.` : `A timed full-paper rehearsal of ${paper.label} with the real JELET marking rules.`}>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href={base}>Today</a> <span aria-hidden="true">›</span>
    <a href={`${base}practice/`}>Practice</a> <span aria-hidden="true">›</span>
    <span>{paper.label}</span>
  </nav>

  {provisional.length > 0 ? (
    <>
      <h1>{paper.label} · provisional practice</h1>
      <p class="lead">{provisional.length} questions available for provisional comparison.</p>
      <p><a href={`${base}library/${paper.id}/`}>Read all {paper.questionCount} questions</a> · <a href={`${base}practice/`}>Other years</a></p>
      <ProvisionalPractice paper={paper} questions={provisional} />
    </>
  ) : (<>
  <div class="row-between" style="align-items:flex-start;margin-bottom:1rem">
    <div class="grow">
      <p class="eyebrow">Full paper rehearsal</p>
      <h1 style="font-size:clamp(1.7rem,5vw,2.6rem)">{paper.label}</h1>
      <p class="lead">
        {questions.length} questions · {scopeMarks} marks · {paper.durationMinutes} minutes ·
        {' '}Category I +1/−¼, Category II +2 with partial credit.
      </p>
      <div class="chip-row">
        {key?.tier === 'official' && <span class="chip official">Official WBJEEB key · {key.documentRef}</span>}
        {key?.tier === 'derived' && <span class="chip derived">Derived key · the board published none for {paper.year}</span>}
        <span class="chip">{tierLabel}</span>
        {paper.boardAwardedQuestions > 0 && <span class="chip info">{paper.boardAwardedQuestions} voided by the board · awarded to everyone</span>}
      </div>
    </div>
    <div class="btn-row">
      <a class="btn ghost" href={`${base}practice/${paper.id}/print/`}>Printed companion</a>
      <a class="btn ghost" href={`${base}practice/${paper.id}/reconciliation/`}>Reconciliation</a>
      <a class="btn ghost" href={`${base}library/${paper.id}/`}>Read the paper</a>
      <a class="btn ghost" href={`${base}practice/`}>Other sets</a>
    </div>
  </div>

  {paper.heldQuestions > 0 && (
    <div class="notice" style="margin-bottom:1rem">
      <strong>This is a labelled incomplete paper.</strong> {paper.heldQuestions} of the {paper.questionCount}
      questions in {paper.year} depend on a diagram or options that the preserved transcription does not reproduce, so
      they cannot be marked. They are excluded from the paper above and from the total — the maximum you can score here
      is {scopeMarks} of the paper's {paper.maxMarks} marks.
      {paper.boardAwardedQuestions > 0 && ` ${paper.boardAwardedQuestions} more question${paper.boardAwardedQuestions === 1 ? ' was' : 's were'} voided by the board, so its marks go to every candidate; ${paper.boardAwardedMarks} of the {scopeMarks} marks above come from the board's award rather than from your answers.`}
      Read the held items in the <a href={`${base}library/${paper.id}/`}>full paper view</a>.
    </div>
  )}

  <Runner paper={paper} questions={questions} mode="mock" scope="full" limitSeconds={limitSeconds} />
  </>)}
</Site>
