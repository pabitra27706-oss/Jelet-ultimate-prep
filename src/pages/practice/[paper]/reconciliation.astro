---
/**
 * The reconciliation evidence for a paper.
 *
 * This page is what a reviewer uses to check the engine by hand:
 *
 * - the reference sheet: a synthetic set of answers with the marks each one
 *   must produce under the published rule, computed independently of the
 *   runner;
 * - the reconciliation ledger: one row per printed number, with the rule that
 *   applies to it;
 * - the expected totals for the year, so a reviewer can compare item by item
 *   rather than checking a single coincidentally-correct number.
 *
 * Nothing here is a candidate's sheet. The answers are generated by a fixed
 * pattern, so two runs always produce the same sheet.
 */
import Site from '../../../layouts/Site.astro';
import { papers, paperById, keyFor, keyTierLabel } from '../../../lib/content';
import { ledgerFor, omrSheetFor, referenceSheetFor } from '../../../lib/rehearsal';

export function getStaticPaths() {
  return papers
    .filter((paper) => paper.scoreableQuestions > 0)
    .map((paper) => ({ params: { paper: paper.id } }));
}

const { paper: paperId } = Astro.params;
const paper = paperById.get(paperId ?? '');
if (!paper) throw new Error(`Unknown paper: ${paperId}`);
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const key = keyFor(paper);
const ledger = ledgerFor(paper);
const sheet = omrSheetFor(paper);
const reference = referenceSheetFor(paper);

const fractionText = (value: { n: number; d: number }) => (value.d === 1 ? String(value.n) : `${value.n}/${value.d}`);
---

<Site
  title={`${paper.label} · reconciliation`}
  active="practice"
  description={`Reconciliation evidence for ${paper.label}: the reference sheet, the ledger and the expected totals.`}
>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href={base}>Today</a> <span aria-hidden="true">›</span>
    <a href={`${base}practice/`}>Practice</a> <span aria-hidden="true">›</span>
    <a href={`${base}practice/${paper.id}/`}>{paper.label}</a> <span aria-hidden="true">›</span>
    <span>Reconciliation</span>
  </nav>

  <div class="row-between" style="align-items:flex-start;margin-bottom:1rem">
    <div class="grow">
      <p class="eyebrow">Reconciliation evidence</p>
      <h1 style="font-size:clamp(1.6rem,4.6vw,2.3rem)">{paper.label} · reference sheet and ledger</h1>
      <p class="lead">
        A synthetic answer sheet with the marks each item must produce, a ledger of every printed number,
        and the totals a reviewer should expect for {paper.year}.
      </p>
      <div class="chip-row">
        <span class="chip">{keyTierLabel(key)}</span>
        {paper.boardAwardedQuestions > 0 && <span class="chip info">{paper.boardAwardedQuestions} voided by the board</span>}
        {paper.heldQuestions > 0 && <span class="chip held">{paper.heldQuestions} held</span>}
      </div>
    </div>
    <div class="btn-row no-print">
      <a class="btn ghost" href={`${base}practice/${paper.id}/print/`}>Printed companion</a>
      <a class="btn ghost" href={`${base}practice/${paper.id}/`}>Sit it on screen</a>
    </div>
  </div>

  <section class="card" style="margin-bottom:1.4rem" aria-labelledby="totals-heading">
    <h2 id="totals-heading" style="font-size:1.1rem">Expected totals for {paper.year}</h2>
    <div class="table" role="table">
      <div role="row"><b role="cell">Questions on the printed paper</b><span role="cell">{ledger.totals.printed} transcribed, {ledger.totals.missing} missing in the transcript</span></div>
      <div role="row"><b role="cell">Markable against a key</b><span role="cell">{ledger.totals.scoreable} questions · {ledger.totals.keyedMarks} marks</span></div>
      <div role="row"><b role="cell">Voided by the board</b><span role="cell">{ledger.totals.voided} questions · {ledger.totals.voidedMarks} marks awarded to every candidate</span></div>
      <div role="row"><b role="cell">Held</b><span role="cell">{ledger.totals.held} questions · {ledger.totals.heldMarks} marks no candidate can earn from this transcript</span></div>
      <div role="row"><b role="cell">Marks a candidate can earn</b><span role="cell">{ledger.totals.marks} of the paper's {paper.maxMarks} printed marks</span></div>
      <div role="row"><b role="cell">Category split</b><span role="cell">{ledger.totals.categoryI} Category I · {ledger.totals.categoryII} Category II</span></div>
      <div role="row"><b role="cell">Time on the paper</b><span role="cell">{paper.durationMinutes} minutes</span></div>
    </div>
    {ledger.blockedReason && (
      <p class="micro" style="margin-top:.7rem">
        <strong>Why this is a labelled incomplete paper:</strong> {ledger.blockedReason}
      </p>
    )}
  </section>

  {reference ? (
    <section class="card" style="margin-bottom:1.4rem" aria-labelledby="reference-heading">
      <div class="section-head">
        <h2 id="reference-heading" style="font-size:1.1rem">Reference sheet</h2>
        <span class="micro">Synthetic answers · fixed pattern · not a candidate's sheet</span>
      </div>
      <p class="small" style="color:var(--muted)">
        The pattern rotates through every scoring path: a correct Category I item, a wrong Category I item,
        a blank, a fully correct Category II item, a Category II item with a wrong option and a Category II
        item with a correct subset. The expected marks below are computed directly from the published rule,
        independently of the runner.
      </p>
      <div class="table-wrap">
        <table class="table" data-reference-sheet>
          <thead>
            <tr>
              <th scope="col">Q</th>
              <th scope="col">Cat.</th>
              <th scope="col">Marks</th>
              <th scope="col">Marked</th>
              <th scope="col">Expected status</th>
              <th scope="col">Expected marks</th>
              <th scope="col">Why</th>
            </tr>
          </thead>
          <tbody>
            {reference.items.map((item) => (
              <tr data-reference-status={item.expectedStatus}>
                <th scope="row">{item.printedNumber}</th>
                <td>{item.category}</td>
                <td>{item.marks}</td>
                <td>{item.marked.length ? item.marked.join(', ') : '—'}</td>
                <td>{item.expectedStatus}</td>
                <td>{fractionText(item.expectedAwarded)}</td>
                <td class="small">{item.note}</td>
              </tr>
            ))}
          </tbody>
          <tfoot>
            <tr>
              <th scope="row" colspan="5">Total from the synthetic answers</th>
              <td>{fractionText(reference.expectedTotal)}</td>
              <td class="small">
                {reference.counts.correct ?? 0} correct · {reference.counts.partial ?? 0} partial ·
                {' '}{reference.counts.wrong ?? 0} wrong · {reference.counts.blank ?? 0} blank
                {reference.counts.voided ? ` · ${reference.counts.voided} voided` : ''}
              </td>
            </tr>
            {reference.counts.voided ? (
              <tr>
                <th scope="row" colspan="5">Plus the board's award on its voided items</th>
                <td>{fractionText(reference.voidedMarks)}</td>
                <td class="small">Awarded to every candidate, whatever was marked.</td>
              </tr>
            ) : null}
            <tr>
              <th scope="row" colspan="5">Credited total</th>
              <td data-reference-total>{fractionText(reference.creditedTotal)}</td>
              <td class="small">What the runner must produce for this sheet.</td>
            </tr>
          </tfoot>
        </table>
      </div>
    </section>
  ) : (
    <section class="card" style="margin-bottom:1.4rem">
      <p class="small">This paper has no published key, so it has no reference sheet. It is offered for reading only.</p>
    </section>
  )}

  <section class="card" style="margin-bottom:1.4rem" aria-labelledby="ledger-heading">
    <div class="section-head">
      <h2 id="ledger-heading" style="font-size:1.1rem">Ledger</h2>
      <span class="micro">{ledger.rows.length} printed numbers · {sheet?.rows.length ?? 0} on the answer sheet</span>
    </div>
    <div class="table-wrap">
      <table class="table" data-reconciliation-ledger>
        <thead>
          <tr>
            <th scope="col">Q</th>
            <th scope="col">Section</th>
            <th scope="col">Cat.</th>
            <th scope="col">Marks</th>
            <th scope="col">Status</th>
            <th scope="col">Rule</th>
          </tr>
        </thead>
        <tbody>
          {ledger.rows.map((row) => (
            <tr data-ledger-row={row.printedNumber} data-ledger-status={row.status}>
              <th scope="row">{row.printedNumber}</th>
              <td>{row.subject}</td>
              <td>{row.category}</td>
              <td>{row.marks}</td>
              <td>
                <span class={`pill ${row.status === 'scoreable' ? 'correct' : row.status === 'voided' ? 'voided' : 'held'}`}>
                  {row.status === 'scoreable' ? 'Markable' : row.status === 'voided' ? 'Voided' : 'Held'}
                </span>
              </td>
              <td class="small">
                {row.rule}
                {row.holdReason && <span class="micro"> {row.holdReason}</span>}
              </td>
            </tr>
          ))}
        </tbody>
        <tfoot>
          <tr>
            <th scope="row" colspan="3">Totals</th>
            <td>{ledger.totals.marks}</td>
            <td colspan="2" class="small">
              {ledger.totals.scoreable} markable · {ledger.totals.voided} voided · {ledger.totals.held} held
            </td>
          </tr>
        </tfoot>
      </table>
    </div>
  </section>

  <section class="card">
    <h2 style="font-size:1.1rem">How to use this page</h2>
    <ol class="small" style="color:var(--muted);padding-left:1.1rem">
      <li>Sit the paper on screen and answer the items the reference sheet names.</li>
      <li>Check the result item by item against the expected status and expected marks above — not just the total.</li>
      <li>Confirm the voided rows carry their full marks and the held rows carry none.</li>
      <li>The reconciliation ledger must show the same printed numbers, in the same order, as the printed companion's answer sheet.</li>
    </ol>
  </section>
</Site>
