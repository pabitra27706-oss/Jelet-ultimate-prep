---
import Site from '../layouts/Site.astro';
import { papers, scorablePapers, mockPaper, rehearsableQuestions, subjectLabels, type SubjectKey } from '../lib/content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const totalQuestions = papers.reduce((sum, paper) => sum + paper.questionCount, 0);
const scorableQuestions = papers.reduce((sum, paper) => sum + paper.scoreableQuestions, 0);
const boardAwardedQuestions = papers.reduce((sum, paper) => sum + paper.boardAwardedQuestions, 0);
const sitTotal = papers.reduce((sum, paper) => sum + paper.rehearsableQuestions, 0);
const officialPapers = scorablePapers.filter((paper) => paper.keyTier === 'official');
const derivedPapers = scorablePapers.filter((paper) => paper.keyTier === 'derived');
const readOnlyPapers = papers.filter((paper) => !paper.hasKey);

/**
 * The corpus grows, so the sentence that counts it is derived rather than
 * written out. A hard-coded "seven" was correct once and silently wrong the
 * next time a paper was added.
 */
const paperWord = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten'][
  papers.length
] ?? String(papers.length);
const drills = mockPaper.subjects
  .map((subject) => {
    const items = rehearsableQuestions(mockPaper, subject.subjectKey);
    return { ...subject, count: items.length, marks: items.reduce((sum, question) => sum + question.marks, 0) };
  })
  .filter((subject) => subject.count > 0);
---
<Site title="Today" active="today" description="Your JELET Paper I dashboard: a timed full mock, subject drills, previous-year papers with board answer keys, and spaced revision built from your own attempts.">
  <section class="today-hero" aria-labelledby="today-title">
    <div class="today-hero-copy">
      <p class="eyebrow">Paper I · your study desk</p>
      <h1 id="today-title">A little progress, every day.</h1>
      <p class="today-subjects">Mathematics <span aria-hidden="true">·</span> Physics <span aria-hidden="true">·</span> Chemistry <span aria-hidden="true">·</span> Electrical &amp; Electronics</p>
      <p class="micro">No account. Your answers stay on this device; nothing is uploaded.</p>
    </div>
    <div class="today-next">
      <p class="today-next-label"><span aria-hidden="true">—</span> Your next step</p>
      <h2>Choose what to study today</h2>
      <p>Make a focused plan from your own practice, or start with a paper.</p>
      <a class="today-primary-action" href={`${base}plan/`}>Make today’s plan <span aria-hidden="true">→</span></a>
      <div class="today-quick-links" aria-label="More ways to begin">
        <a href={`${base}practice/${mockPaper.id}/`}>Start the {mockPaper.year} full paper</a>
        <a href={`${base}mock/`}>Build your own mock</a>
      </div>
    </div>
    <p class="today-corpus">
      <strong>{totalQuestions} questions</strong> across {paperWord} previous-year papers
      <span aria-hidden="true">·</span> {scorableQuestions} marked against a key
      <span aria-hidden="true">·</span> {boardAwardedQuestions} awarded by the board
      <span aria-hidden="true">·</span> {officialPapers.length} official, {derivedPapers.length} derived, {readOnlyPapers.length} read-only papers
    </p>
  </section>

  <section class="today-record" aria-labelledby="today-stats">
    <div class="section-head">
      <h2 id="today-stats">Your record</h2>
      <span class="micro" data-storage-note>Loaded from this browser only.</span>
    </div>
    <div class="stat-grid today-stat-grid">
      <div class="stat"><b data-stat="attempted">—</b><span>Questions attempted</span><em data-stat-note="attempted">of {scorableQuestions} you can answer · {sitTotal} sit-able, {boardAwardedQuestions} awarded by the board</em></div>
      <div class="stat"><b data-stat="accuracy">—</b><span>Independent accuracy</span><em data-stat-note="accuracy">correct on a first, unassisted attempt</em></div>
      <div class="stat"><b data-stat="due">—</b><span>Reviews due</span><em data-stat-note="due">wrong or blank questions, spaced by a fixed ladder</em></div>
      <div class="stat"><b data-stat="streak">—</b><span>Day streak</span><em data-stat-note="streak">days with at least one submitted paper</em></div>
    </div>
    <div class="row-between" style="margin-top:.9rem">
      <p class="micro" data-today-message>Reading a page never changes these numbers — only a submitted attempt does.</p>
      <a class="btn ghost small" href={`${base}review/`}>Open the review desk</a>
    </div>
  </section>

  <section class="today-section" aria-labelledby="continue-heading">
    <div class="section-head">
      <h2 id="continue-heading">Pick up where you stopped</h2>
    </div>
    <div id="continue-slot">
      <div class="empty today-empty">
        <span class="today-empty-icon" aria-hidden="true">↗</span>
        <span>Nothing started yet on this device.</span>
        <a href={`${base}library/`}>Browse papers</a>
      </div>
    </div>
    <div id="lesson-slot" class="today-lesson-slot"></div>
  </section>

  <section class="today-section" aria-labelledby="drills-heading">
    <div class="section-head">
      <h2 id="drills-heading">Subject drills · {mockPaper.year}</h2>
      <a class="micro" href={`${base}library/${mockPaper.id}/`}>Read the whole paper →</a>
    </div>
    <p class="micro">
      Each drill holds only questions that carry a published key and a complete set of options. The count is the
      real number of questions, not a target.
    </p>
    <div class="card-grid">
      {drills.map((subject) => (
        <a class="linkrow" href={`${base}practice/${mockPaper.id}/${subject.subjectKey}/`}>
          <span>
            <strong>{subjectLabels[subject.subjectKey as SubjectKey]}</strong>
            <small>{subject.count} questions · {subject.marks} marks · {subject.categories.map((category) => `Cat ${category.category}`).join(' + ')}</small>
          </span>
          <span aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </section>

  <section class="today-section" aria-labelledby="papers-heading">
    <div class="section-head">
      <h2 id="papers-heading">Previous-year papers</h2>
      <a class="micro" href={`${base}library/`}>All papers and what each one can do →</a>
    </div>
    <div class="card-grid">
      {papers.map((paper) => (
        <a class="linkrow" href={`${base}library/${paper.id}/`}>
          <span>
            <strong>{paper.label}</strong>
            <small>
              {paper.questionCount} questions · {paper.hasKey ? `${paper.scoreableQuestions} scoreable` : 'read only (no key published)'} ·
              {paper.boardAwardedQuestions > 0 && ` ${paper.boardAwardedQuestions} awarded by the board ·`}
              {' '}{paper.gaps.length > 0 ? `${paper.gaps.length} missing in transcription` : 'complete numbering'}
            </small>
          </span>
          <span aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </section>

  <section class="card today-trust" aria-labelledby="honest-heading">
    <h2 id="honest-heading" style="font-size:1.15rem">What this site does and does not claim</h2>
    <ul class="small" style="color:var(--muted)">
      <li>Marks follow the published JELET rules: Category I gives +1, −1/4 for a wrong or multiple answer; Category II gives +2, 0 when a wrong option is marked, and partial credit for a correct subset.</li>
      <li>Questions that depend on a diagram the transcription does not reproduce are shown for reading but are never marked, and never counted in a total.</li>
      <li>A question the board voided — published as "W", so no option is keyed — carries its full marks to every candidate. Those marks are in the totals, and the item is labelled wherever it appears.</li>
      <li>Accuracy is reported with its denominator, and an assisted answer never counts as an independent one. There is no rank, no predicted score and no streak that survives without a submitted paper.</li>
      <li>No account, no server and no tracking. Clearing site data loses this record — export it from the <a href={`${base}workspace/`}>workspace</a>.</li>
      <li>You can keep a whole paper on your device with the <a href={`${base}offline/`}>offline packs</a>. Nothing is downloaded until you ask, and a failed download never replaces a pack that already works.</li>
    </ul>
  </section>

  <span hidden data-scorable-total={scorableQuestions} data-sit-total={sitTotal} data-board-awarded-total={boardAwardedQuestions} data-base={base}></span>
  <script>
    import { readAttempts } from '../lib/attempts';
    import { readQueue } from '../lib/review';
    import { buildStats } from '../lib/stats';
    import { readProgress, isSection } from '../progress';

    const marker = document.querySelector<HTMLElement>('[data-scorable-total]');
    // The coverage denominator is the answerable corpus. A board-voided item
    // is awarded to everyone and is never answered, so it is not something the
    // learner can cover.
    const scorableTotal = Number(marker?.dataset.scorableTotal ?? '0');
    const sitTotal = Number(marker?.dataset.sitTotal ?? String(scorableTotal));
    const boardAwardedTotal = Number(marker?.dataset.boardAwardedTotal ?? '0');
    const base = marker?.dataset.base ?? '/';
    const attempts = readAttempts();
    const queue = readQueue();
    const stats = buildStats(attempts, queue, scorableTotal);

    const set = (key: string, value: string) => {
      const node = document.querySelector(`[data-stat="${key}"]`);
      if (node) node.textContent = value;
    };
    const setNote = (key: string, value: string) => {
      const node = document.querySelector(`[data-stat-note="${key}"]`);
      if (node) node.textContent = value;
    };

    set('attempted', String(stats.questionsAttempted));
    setNote('attempted', `of ${scorableTotal} you can answer · ${sitTotal} sit-able, ${boardAwardedTotal} awarded by the board`);
    set('accuracy', stats.accuracy === null ? '—' : `${Math.round(stats.accuracy * 100)}%`);
    setNote('accuracy', stats.independentAnswered > 0
      ? `${stats.independentCorrect} of ${stats.independentAnswered} first attempts, without hints`
      : 'no submitted attempt yet');
    set('due', String(stats.dueNow));
    setNote('due', stats.queueSize > 0 ? `${stats.queueSize} questions in the review queue` : 'nothing waiting for review');
    set('streak', String(stats.streak));

    // The lesson's own reading position, if the learner started the chapter.
    const lessonSlot = document.querySelector('#lesson-slot');
    const { progress } = readProgress('parallel-circuits');
    if (lessonSlot && progress && isSection(progress.section)) {
      const row = document.createElement('div');
      row.className = 'card-flat';
      const link = document.createElement('a');
      link.className = 'linkrow';
      const left = document.createElement('span');
      const strong = document.createElement('strong');
      strong.textContent = 'Parallel circuits · the lesson';
      const small = document.createElement('small');
      small.textContent = `Last section: ${progress.section.replaceAll('-', ' ')}`;
      left.append(strong, small);
      const arrow = document.createElement('span');
      arrow.setAttribute('aria-hidden', 'true');
      arrow.textContent = '→';
      link.append(left, arrow);
      link.href = `${base}learn/parallel-circuits/?resume=1#${progress.section}`;
      row.append(link);
      lessonSlot.replaceChildren(row);
    }

    const slot = document.querySelector('#continue-slot');
    const resume = attempts.find((attempt) => !attempt.submittedAt)
      ?? [...attempts].sort((a, b) => (b.submittedAt ?? b.updatedAt) - (a.submittedAt ?? a.updatedAt))[0];
    // A composed mock is not a paper in the archive, so it is reopened
    // through the link that composed it.
    const isMock = Boolean(resume?.mockSpec);
    const isQuiz = Boolean(resume?.quizSpec);
    const isPaper = Boolean(resume && /^jelet-et-p1-\d{4}$/.test(resume.paperId));
    if (slot && resume && (isPaper || isMock || isQuiz)) {
      const answered = Object.keys(resume.responses ?? {}).filter((key) => (resume.responses[key] ?? []).length > 0).length;
      const total = resume.questionIds?.length ?? 0;
      const when = new Date(resume.submittedAt ?? resume.updatedAt).toLocaleString();
      const status = resume.submittedAt
        ? `Submitted ${when} · ${answered} of ${total} answered`
        : `In progress · ${answered} of ${total} answered`;
      const paperSlug = resume.paperId.replace('jelet-et-p1-', '');

      const card = document.createElement('div');
      card.className = 'card-flat';
      const info = document.createElement('div');
      const title = document.createElement('strong');
      title.textContent = resume.title;
      const note = document.createElement('div');
      note.className = 'micro';
      note.textContent = `${status} · ${resume.paperLabel}`;
      info.append(title, note);
      const link = document.createElement('a');
      link.className = 'btn small';
      link.href = isQuiz
        ? `${base}quiz/?${resume.quizSpec}`
        : isMock
          ? `${base}mock/run/?${resume.mockSpec}`
          : `${base}practice/${paperSlug}/${resume.subjectKey ? `${resume.subjectKey}/` : ''}`;
      link.textContent = resume.submittedAt ? 'Review this attempt' : 'Continue';
      const row = document.createElement('div');
      row.className = 'row-between';
      row.append(info, link);
      card.append(row);
      slot.replaceChildren(card);
    }
  </script>
</Site>
